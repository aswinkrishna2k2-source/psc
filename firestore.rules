rules_version = '2';

// Browsers never touch Firestore directly. All reads and writes go through the Cloud Function,
// so students cannot read answers before submitting or change their own scores and progress.
// The Admin SDK used by the function is not subject to these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
